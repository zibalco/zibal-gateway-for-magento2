<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Gateway events are written to var/log/zibal.log -->
    <virtualType name="ChalakSoft\Zibal\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/zibal.log</argument>
        </arguments>
    </virtualType>

    <virtualType name="ChalakSoft\Zibal\Logger\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">zibal</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">ChalakSoft\Zibal\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="ChalakSoft\Zibal\Helper\Zibal">
        <arguments>
            <argument name="logger" xsi:type="object">ChalakSoft\Zibal\Logger\Logger</argument>
        </arguments>
    </type>

    <type name="ChalakSoft\Zibal\Model\PaymentService">
        <arguments>
            <argument name="logger" xsi:type="object">ChalakSoft\Zibal\Logger\Logger</argument>
        </arguments>
    </type>

    <type name="ChalakSoft\Zibal\Controller\Index\Index">
        <arguments>
            <argument name="logger" xsi:type="object">ChalakSoft\Zibal\Logger\Logger</argument>
        </arguments>
    </type>

    <type name="ChalakSoft\Zibal\Controller\Index\Callback">
        <arguments>
            <argument name="logger" xsi:type="object">ChalakSoft\Zibal\Logger\Logger</argument>
        </arguments>
    </type>
</config>
